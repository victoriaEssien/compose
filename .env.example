# Compose environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL; Neon's pooled connection string works well)
DATABASE_URL=postgresql://user:password@host/compose?sslmode=require

# Better Auth
# Generate a secret with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OpenAI (content analysis, copy, design planning, structured output)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vercel Blob (asset uploads and exported PNGs)
# Create a Blob store in the Vercel dashboard and copy the read/write token.
BLOB_READ_WRITE_TOKEN=
