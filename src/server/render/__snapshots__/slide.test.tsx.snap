// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`slideElement > lays the code template out the same way every time 1`] = `"<div style="display:flex;flex-direction:column;width:1080px;height:1350px;padding:80px;background-color:#0B0B0F;color:#F5F5F7;font-family:Space Grotesk"><div style="display:flex;flex-direction:column;flex:1;justify-content:center;align-items:flex-start;text-align:left"><div style="display:flex;flex-direction:column;gap:32px;width:100%"><span style="font-size:54px;font-weight:700;line-height:1.08;letter-spacing:-1px">One index, no Redis</span><div style="display:flex;flex-direction:column;width:100%;padding:32px;border-radius:16px;background-color:#000000;border:1px solid #22D3EE;font-family:JetBrains Mono;font-size:26px;line-height:1.5"><div style="display:flex"><span style="color:#F97583;white-space:pre">create</span><span style="color:#E1E4E8;white-space:pre"> </span><span style="color:#F97583;white-space:pre">index</span><span style="color:#E1E4E8;white-space:pre"> </span><span style="color:#B392F0;white-space:pre">concurrently</span></div><div style="display:flex"><span style="color:#E1E4E8;white-space:pre">  </span><span style="color:#F97583;white-space:pre">on</span><span style="color:#E1E4E8;white-space:pre"> post (user_id);</span></div><div style="display:flex"><span style="white-space:pre"> </span></div><div style="display:flex"><span style="color:#E1E4E8;white-space:pre">analyze post;</span></div></div><span style="font-size:32px;line-height:1.45;font-family:Inter;color:#8A8A96">Concurrently, so the table keeps serving reads while it builds.</span></div></div><div style="display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:center"><div style="display:flex;width:44px;height:44px;border-radius:22px;background-color:#22D3EE"></div><span style="margin-left:16px;font-size:24px;font-family:Inter;color:#8A8A96">@codebreaker</span></div><span style="font-size:24px;color:#F5F5F773">3 / 9</span></div></div>"`;

exports[`slideElement > lays the comparison template out the same way every time 1`] = `"<div style="display:flex;flex-direction:column;width:1080px;height:1350px;padding:80px;background-color:#0B0B0F;color:#F5F5F7;font-family:Space Grotesk"><div style="display:flex;flex-direction:column;flex:1;justify-content:center;align-items:flex-start;text-align:left"><div style="display:flex;flex-direction:column;gap:44px;width:100%"><span style="font-size:54px;font-weight:700;line-height:1.08;letter-spacing:-1px">Before and after</span><div style="display:flex;gap:24px;width:100%"><div style="display:flex;flex-direction:column;padding:32px;border-radius:16px;background-color:transparent;border:2px solid #F5F5F72e;flex:1;gap:16px"><span style="font-size:22px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#8A8A96">Before</span><span style="font-size:30px;line-height:1.4;font-family:Inter">Sequential scan over 2M rows, roughly 400ms per request.</span></div><div style="display:flex;flex-direction:column;padding:32px;border-radius:16px;background-color:transparent;border:2px solid #F5F5F72e;flex:1;gap:16px"><span style="font-size:22px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#22D3EE">After</span><span style="font-size:30px;line-height:1.4;font-family:Inter">Index scan, roughly 2ms per request.</span></div></div></div></div><div style="display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:center"><div style="display:flex;width:44px;height:44px;border-radius:22px;background-color:#22D3EE"></div><span style="margin-left:16px;font-size:24px;font-family:Inter;color:#8A8A96">@codebreaker</span></div><span style="font-size:24px;color:#F5F5F773">3 / 9</span></div></div>"`;

exports[`slideElement > lays the cover template out the same way every time 1`] = `"<div style="display:flex;flex-direction:column;width:1080px;height:1350px;padding:80px;background-color:#0B0B0F;color:#F5F5F7;font-family:Space Grotesk"><div style="display:flex;flex-direction:column;flex:1;justify-content:center;align-items:flex-start;text-align:left"><div style="display:flex;flex-direction:column;gap:32px;width:100%"><span style="font-size:76px;font-weight:700;line-height:1.08;letter-spacing:-1px">You probably don&#x27;t need Redis yet</span><span style="font-size:32px;line-height:1.45;font-family:Inter;color:#8A8A96">The 400ms query was a missing index, not a caching problem.</span></div></div><div style="display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:center"><div style="display:flex;width:44px;height:44px;border-radius:22px;background-color:#22D3EE"></div><span style="margin-left:16px;font-size:24px;font-family:Inter;color:#8A8A96">@codebreaker</span></div><span style="font-size:24px;color:#F5F5F773">3 / 9</span></div></div>"`;

exports[`slideElement > lays the final template out the same way every time 1`] = `"<div style="display:flex;flex-direction:column;width:1080px;height:1350px;padding:80px;background-color:#0B0B0F;color:#F5F5F7;font-family:Space Grotesk"><div style="display:flex;flex-direction:column;flex:1;justify-content:center;align-items:flex-start;text-align:left"><div style="display:flex;flex-direction:column;gap:32px;width:100%"><span style="font-size:22px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#22D3EE;margin-bottom:24px">That is it</span><span style="font-size:76px;font-weight:700;line-height:1.08;letter-spacing:-1px">Reach for the index first</span><span style="font-size:32px;line-height:1.45;font-family:Inter;color:#8A8A96">Caching cannot fix what the database is doing slowly on purpose.</span><div style="display:flex;margin-top:16px;padding:20px 32px;border-radius:16px;background-color:#22D3EE"><span style="font-size:30px;font-weight:700;color:#0B0B0F">Follow for more backend notes</span></div></div></div><div style="display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:center"><div style="display:flex;width:44px;height:44px;border-radius:22px;background-color:#22D3EE"></div><span style="margin-left:16px;font-size:24px;font-family:Inter;color:#8A8A96">@codebreaker</span></div><span style="font-size:24px;color:#F5F5F773">3 / 9</span></div></div>"`;

exports[`slideElement > lays the numbered_list template out the same way every time 1`] = `"<div style="display:flex;flex-direction:column;width:1080px;height:1350px;padding:80px;background-color:#0B0B0F;color:#F5F5F7;font-family:Space Grotesk"><div style="display:flex;flex-direction:column;flex:1;justify-content:center;align-items:flex-start;text-align:left"><div style="display:flex;flex-direction:column;gap:44px;width:100%"><span style="font-size:54px;font-weight:700;line-height:1.08;letter-spacing:-1px">Three things that helped</span><div style="display:flex;flex-direction:column;gap:28px;width:100%"><div style="display:flex;width:100%"><span style="min-width:104px;font-size:54px;font-weight:700;color:#22D3EE">01</span><div style="display:flex;flex-direction:column;flex:1;gap:8px"><span style="font-size:30px;font-weight:700">Measure before you cache</span><span style="font-size:26px;line-height:1.4;font-family:Inter;color:#8A8A96">Profile the query, do not guess at it.</span></div></div><div style="display:flex;width:100%"><span style="min-width:104px;font-size:54px;font-weight:700;color:#22D3EE">02</span><div style="display:flex;flex-direction:column;flex:1;gap:8px"><span style="font-size:30px;font-weight:700">Index the filter column</span><span style="font-size:26px;line-height:1.4;font-family:Inter;color:#8A8A96">One index took 400ms down to 2ms.</span></div></div><div style="display:flex;width:100%"><span style="min-width:104px;font-size:54px;font-weight:700;color:#22D3EE">03</span><div style="display:flex;flex-direction:column;flex:1;gap:8px"><span style="font-size:30px;font-weight:700">Keep the infra boring</span></div></div></div></div></div><div style="display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:center"><div style="display:flex;width:44px;height:44px;border-radius:22px;background-color:#22D3EE"></div><span style="margin-left:16px;font-size:24px;font-family:Inter;color:#8A8A96">@codebreaker</span></div><span style="font-size:24px;color:#F5F5F773">3 / 9</span></div></div>"`;

